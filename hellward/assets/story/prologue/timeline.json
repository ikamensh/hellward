 "words": [
  {
   "text": "Your saints built this cathedral on the door to hell...",
   "at": 0.3,
   "voice": "glass",
   "length": 3.236
  },
  {
   "text": "and lit a lamp, to keep it shut.",
   "at": 4.125,
   "length": 1.783
  },
  {
   "text": "Nine hundred years, it burned. Tonight... it gutters.",
   "at": 6.208,
   "voice": "lamp",
   "length": 4.503
  },
  {
   "text": "So you wake what the old house still holds.",
   "at": 14.961,
   "voice": "wake",
   "length": 3.201
  },
  {
   "text": "Its fire.",
   "at": 18.712,
   "voice": "fire",
   "length": 0.83
  },
  {
   "text": "Its thunder.",
   "at": 20.412,
   "voice": "thunder",
   "length": 0.884
  },
  {
   "text": "Its frost.",
   "at": 22.112,
   "voice": "frost",
   "length": 0.886
  },
  {
   "text": "And its dead.",
   "at": 23.862,
   "voice": "dead",
   "length": 1.067
  },
  {
   "text": "I know this house. I kept its lamp, once.",
   "at": 26.712,
   "voice": "priest",
   "length": 3.535
  },
  {
   "text": "Now I cast the bones... and watch the fight a hundred times, before it begins.",
   "at": 31.047,
   "voice": "bones",
   "length": 6.957
  },
  {
   "text": "I know which tower to break. And when.",
   "at": 38.754,
   "voice": "curse",
   "length": 2.796
  },
  {
   "text": "In every night I have seen... the lamp goes out.",
   "at": 42.3,
   "voice": "ember",
   "length": 4.184
  }
 ]
